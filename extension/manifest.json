{
  "manifest_version": 3,
  "name": "Heatmark",
  "version": "1.0.0",
  "description": "Understand your bookmarks: see which ones you use, keep the important ones a keystroke away, and clear out the rest.",
  "minimum_chrome_version": "114",
  "permissions": [
    "bookmarks",
    "history",
    "storage",
    "unlimitedStorage",
    "favicon",
    "activeTab"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Heatmark (Alt+K)",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png"
    }
  },
  "options_page": "manager.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; img-src 'self' data:; connect-src 'none'; base-uri 'none'; form-action 'none'"
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+K"
      },
      "description": "Open the Heatmark palette"
    }
  }
}
